{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make format)",
      "Bash(make format-check)",
      "Bash(make clippy:*)",
      "Bash(make test)",
      "Bash(make elf:*)",
      "Bash(make disasm)",
      "Bash(cargo test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Edit(/rust-toolchain)",
      "Edit(/x86_64.json)",
      "Edit(/linker.lds)",
      "Edit(/VERSION)",
      "Edit(/lib/**)",
      "Write(/rust-toolchain)",
      "Write(/x86_64.json)",
      "Write(/linker.lds)",
      "Write(/VERSION)",
      "Write(/lib/**)",
      "Bash(make install:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)"
    ]
  }
}
